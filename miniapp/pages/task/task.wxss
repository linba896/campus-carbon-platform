.page{padding:54rpx 34rpx}.type{color:#d6ff2f;font-size:25rpx}.title{font-size:52rpx;font-weight:800;margin:20rpx 0}.meta{display:flex;gap:42rpx;color:#8fa0a9}.budget{display:flex;justify-content:space-between;align-items:center;background:#0a1a26;padding:34rpx;margin:48rpx 0}.budget strong{color:#d6ff2f;font-size:46rpx}.block{padding:36rpx 0;border-bottom:1px solid #253640;line-height:1.8;color:#c4cdd2}.label{font-weight:700;color:white;font-size:30rpx;margin-bottom:12rpx}.safe-line{color:#8da05a;font-size:23rpx;margin:38rpx 0}.action{position:fixed;bottom:45rpx;left:34rpx;right:34rpx}.mask{position:fixed;inset:0;background:rgba(0,0,0,.72);display:flex;align-items:flex-end}.sheet{width:100%;background:#0d202d;border-radius:30rpx 30rpx 0 0;padding:24rpx 38rpx 70rpx}.handle{width:80rpx;height:8rpx;background:#53636d;border-radius:10rpx;margin:auto}.lock{font-size:50rpx;margin:35rpx 0 15rpx}.sheet-title{font-size:42rpx;font-weight:800}.fee{display:flex;justify-content:space-between;background:#07141e;padding:32rpx;margin:34rpx 0}.fee strong{color:#d6ff2f;font-size:40rpx}.benefit{line-height:2;color:#bdc8cd;margin-bottom:30rpx}.sheet button{width:100%}

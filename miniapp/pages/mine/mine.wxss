.page{padding:42rpx 30rpx}.profile{display:flex;align-items:center;gap:24rpx;padding:35rpx 10rpx}.avatar{width:104rpx;height:104rpx;border-radius:50%;background:#d6ff2f;color:#07120d;font-size:46rpx;font-weight:800;display:grid;place-items:center}.name{font-size:34rpx;font-weight:700;margin-bottom:8rpx}.profile .muted{font-size:22rpx}.profile button{margin-left:auto;margin-right:0;background:transparent;border:1px solid #d6ff2f;color:#d6ff2f;font-size:24rpx}.panel{background:#0a1a26;border-radius:14rpx;margin-top:30rpx;padding:0 28rpx}.panel view{padding:34rpx 0;border-bottom:1px solid #243642;display:flex;justify-content:space-between}.panel view:last-child{border:0}.panel text{color:#70828d}
